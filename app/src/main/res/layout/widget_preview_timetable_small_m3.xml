<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,NestedWeights"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_m3_preview">
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_compact_preview_date" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textColor="#65558F" />
        <TextView android:layout_width="32dp" android:layout_height="20dp" android:gravity="center"
            android:text="@string/widget_today_label" android:textSize="11sp" android:textColor="#21005D"
            android:background="@drawable/widget_m3_pill" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp"
        android:layout_marginTop="2dp" android:background="@drawable/widget_m3_surface">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="1" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="08:10" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_1" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="2" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="09:10" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_2" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp" android:background="@drawable/widget_m3_pill">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="3" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="10:10" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_3" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="4" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="11:10" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_4" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="5" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="13:00" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_5" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="6" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="14:00" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_6" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="16dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingHorizontal="4dp">
            <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                android:text="7" android:textSize="10.5sp" android:textColor="#65558F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content"
                android:text="15:10" android:textSize="9.5sp" android:textColor="#49454F"
                android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/widget_compact_preview_subject_7" android:textSize="11.5sp"
                android:textColor="#1D1B20" android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_compact_preview_fetched" android:textSize="9.5sp" android:textColor="#49454F" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:padding="2dp"
            android:src="@drawable/widget_m3_refresh" android:contentDescription="@string/widget_refresh_label" />
    </LinearLayout>
</LinearLayout>
